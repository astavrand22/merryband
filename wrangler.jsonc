{
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "merryband",
  "compatibility_date": "2026-09-27",
  // Small Worker that records Every.org donations and serves totals (see worker/index.js).
  // It only runs for /api/* requests; everything else is served straight from the static files.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare creates this database on the first deploy; no ID needed.
  "d1_databases": [
    { "binding": "DB", "database_name": "keysout-donations" }
  ],
  // Required for branch preview builds. Empty is fine.
  "previews": {}
}
